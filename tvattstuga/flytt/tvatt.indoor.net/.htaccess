# Lägg denna fil ensam i mappen tvatt/ på indoor.net (ta bort allt annat där).
# Alla besök – även kalenderprenumerationer – skickas till den nya adressen.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(.*)$ https://pukevagen.cjafastighetobygg.se/$1 [R=301,L]
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
